{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "hadolint",
          "informationUri": "https://github.com/hadolint/hadolint",
          "rules": [
            {
              "id": "DL3002",
              "shortDescription": {
                "text": "Last USER should not be root"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "DL3002",
          "level": "error",
          "message": {
            "text": "SYNTHETIC SAMPLE for the TruStacks Signals workshop, not a scan of your Dockerfile: the container runs as root."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "YOUR-SERVICE-REPO/Dockerfile"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
